<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registro - Informa TdeA</title>
  <link rel="icon" type="image/jpeg" href="/assets/Logo.jpeg" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex">

  <!-- Left panel – background image (hidden on mobile) -->
  <div class="hidden md:flex md:w-1/2 lg:w-3/5 relative overflow-hidden">
    <img src="/assets/fondo_login.jpg" alt="Campus TdeA"
         class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-[#115e59]/60"></div>
    <div class="relative z-10 flex flex-col justify-between p-12 w-full">
      <!-- Brand top-left -->
      <div class="flex items-center gap-4">
        <img src="/assets/Logo.jpeg" alt="TdeA Logo"
             class="w-14 h-14 rounded-2xl object-cover shadow-lg" />
        <div>
          <h2 class="text-white font-bold text-xl tracking-wide leading-tight">INFORMA TDEA</h2>
          <p class="text-[#86efac] tracking-widest text-xs">INSTITUCIÓN UNIVERSITARIA</p>
        </div>
      </div>
      <!-- Bottom tagline -->
      <div>
        <h1 class="text-white text-4xl font-bold leading-snug mb-3">
          Crea tu cuenta<br />en Informa TdeA
        </h1>
        <p class="text-white/80 text-lg">Accede a noticias, eventos y toda la información de la institución.</p>
      </div>
    </div>
  </div>

  <!-- Right panel – form -->
  <div class="w-full md:w-1/2 lg:w-2/5 flex items-center justify-center bg-[#f5f1e8] px-6 py-12 md:px-14 min-h-screen">
    <div class="w-full max-w-md">

      <!-- Mobile-only logo -->
      <div class="flex flex-col items-center mb-8 md:hidden">
        <img src="/assets/Logo.jpeg" alt="TdeA Logo"
             class="w-20 h-20 rounded-2xl object-cover shadow-lg mb-3" />
        <span class="text-[#0f766e] text-lg font-semibold">Informa TdeA</span>
      </div>

      <!-- Heading -->
      <div class="mb-8">
        <h2 class="text-[#134e4a] text-4xl font-bold mb-2">Crear cuenta</h2>
        <p class="text-[#0f766e] text-base">Completa los datos para registrarte.</p>
      </div>

      <!-- Error -->
      <% if (error) { %>
      <div class="mb-5 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
      <% } %>

      <!-- Form -->
      <form action="/register" method="POST" class="flex flex-col gap-4">

        <!-- Documento -->
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Número de documento</label>
          <input
            type="text"
            name="documento"
            inputmode="numeric"
            placeholder="Ej: 1234567890"
            value="<%= old.documento || '' %>"
            required
            class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
        </div>

        <!-- Nombre -->
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Nombre completo</label>
          <input
            type="text"
            name="nombre"
            placeholder="Tu nombre completo"
            value="<%= old.nombre || '' %>"
            required
            class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
        </div>

        <!-- Email -->
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Correo electrónico</label>
          <input
            type="email"
            name="email"
            placeholder="nombre@tdea.edu.co"
            value="<%= old.email || '' %>"
            required
            class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
        </div>

        <!-- Edad + Género -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Edad</label>
            <input
              type="number"
              name="edad"
              placeholder="Ej: 20"
              min="15"
              max="99"
              value="<%= old.edad || '' %>"
              required
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
            />
          </div>
          <div>
            <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Género</label>
            <select
              name="genero"
              required
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
            >
              <option value="" disabled <%= !old.genero ? 'selected' : '' %>>Seleccionar</option>
              <option value="Masculino" <%= old.genero === 'Masculino' ? 'selected' : '' %>>Masculino</option>
              <option value="Femenino" <%= old.genero === 'Femenino' ? 'selected' : '' %>>Femenino</option>
              <option value="Otro" <%= old.genero === 'Otro' ? 'selected' : '' %>>Otro</option>
            </select>
          </div>
        </div>

        <!-- Facultad -->
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Facultad</label>
          <select
            name="facultad"
            required
            class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          >
            <option value="" disabled <%= !old.facultad ? 'selected' : '' %>>Selecciona tu facultad</option>
            <option value="INGENIERIA" <%= old.facultad === 'INGENIERIA' ? 'selected' : '' %>>Ingeniería</option>
            <option value="CIENCIAS_ADMINISTRATIVAS_Y_ECONOMICAS" <%= old.facultad === 'CIENCIAS_ADMINISTRATIVAS_Y_ECONOMICAS' ? 'selected' : '' %>>Ciencias Administrativas y Económicas</option>
            <option value="CIENCIAS_BASICAS_Y_AREAS_COMUNES" <%= old.facultad === 'CIENCIAS_BASICAS_Y_AREAS_COMUNES' ? 'selected' : '' %>>Ciencias Básicas y Áreas Comunes</option>
            <option value="CIENCIAS_SOCIALES_Y_EDUCACION" <%= old.facultad === 'CIENCIAS_SOCIALES_Y_EDUCACION' ? 'selected' : '' %>>Ciencias Sociales y Educación</option>
            <option value="TECNOLOGIAS_Y_CIENCIAS_EXACTAS" <%= old.facultad === 'TECNOLOGIAS_Y_CIENCIAS_EXACTAS' ? 'selected' : '' %>>Tecnologías y Ciencias Exactas</option>
          </select>
        </div>

        <!-- Contraseña -->
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-1.5">Contraseña</label>
          <input
            type="password"
            name="password"
            placeholder="Mínimo 6 caracteres"
            minlength="6"
            required
            class="w-full px-5 py-3 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
          <p class="text-gray-400 text-xs mt-1 ml-1">Mínimo 6 caracteres</p>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-[#115e59] hover:bg-[#134e4a] text-white rounded-xl font-semibold text-base transition-colors duration-200 shadow-md mt-1"
        >
          Registrarse
        </button>
      </form>

      <!-- Back to login -->
      <div class="mt-6 text-center">
        <p class="text-gray-500 text-sm">
          ¿Ya tienes cuenta?
          <a href="/" class="text-[#0f766e] font-semibold hover:underline ml-1">Inicia sesión</a>
        </p>
        <a href="https://tdea.edu.co" target="_blank"
           class="block mt-4 text-gray-400 text-xs hover:text-[#0f766e] transition-colors">
          tdea.edu.co
        </a>
      </div>

    </div>
  </div>

</body>
</html>