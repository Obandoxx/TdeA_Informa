<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Informa TdeA</title>
  <link rel="icon" type="image/jpeg" href="/assets/Logo.jpeg" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex">

  <!-- Left panel – background image (hidden on mobile) -->
  <div class="hidden md:flex md:w-1/2 lg:w-3/5 relative overflow-hidden">
    <img src="/assets/fondo_login.jpg" alt="Campus TdeA"
         class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-[#115e59]/60"></div>
    <div class="relative z-10 flex flex-col justify-between p-12 w-full">
      <!-- Brand top-left -->
      <div class="flex items-center gap-4">
        <img src="/assets/Logo.jpeg" alt="TdeA Logo"
             class="w-14 h-14 rounded-2xl object-cover shadow-lg" />
        <div>
          <h2 class="text-white font-bold text-xl tracking-wide leading-tight">INFORMA TDEA</h2>
          <p class="text-[#86efac] tracking-widest text-xs">INSTITUCIÓN UNIVERSITARIA</p>
        </div>
      </div>
      <!-- Bottom tagline -->
      <div>
        <h1 class="text-white text-4xl font-bold leading-snug mb-3">
          Bienvenido a<br />Informa TdeA
        </h1>
        <p class="text-white/80 text-lg">Tu fuente institucional de noticias y eventos universitarios.</p>
      </div>
    </div>
  </div>

  <!-- Right panel – form -->
  <div class="w-full md:w-1/2 lg:w-2/5 flex items-center justify-center bg-[#f5f1e8] px-6 py-12 md:px-14 min-h-screen">
    <div class="w-full max-w-md">

      <!-- Mobile-only logo -->
      <div class="flex flex-col items-center mb-8 md:hidden">
        <img src="/assets/Logo.jpeg" alt="TdeA Logo"
             class="w-20 h-20 rounded-2xl object-cover shadow-lg mb-3" />
        <span class="text-[#0f766e] text-lg font-semibold">Informa TdeA</span>
      </div>

      <!-- Heading -->
      <div class="mb-8">
        <h2 class="text-[#134e4a] text-4xl font-bold mb-2">Iniciar sesión</h2>
        <p class="text-[#0f766e] text-base">Ingresa tus credenciales para continuar.</p>
      </div>

      <!-- Alertas -->
      <% if (success) { %>
      <div class="mb-5 flex items-center gap-3 bg-[#d9f2e5] border border-[#86efac] text-[#134e4a] text-sm font-medium px-4 py-3 rounded-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17 4 12"/></svg>
        <%= success %>
      </div>
      <% } %>
      <% if (error) { %>
      <div class="mb-5 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <%= error %>
      </div>
      <% } %>

      <!-- Form -->
      <form action="/login" method="POST" class="flex flex-col gap-5">
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-2">Número de documento</label>
          <input
            type="text"
            name="documento"
            placeholder="Tu número de documento"
            inputmode="numeric"
            required
            class="w-full px-5 py-3.5 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
        </div>
        <div>
          <label class="block text-[#134e4a] font-semibold text-sm mb-2">Contraseña</label>
          <input
            type="password"
            name="password"
            placeholder="••••••••"
            required
            class="w-full px-5 py-3.5 bg-white border border-gray-200 rounded-xl text-[#134e4a] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#14b8a6] focus:border-transparent shadow-sm"
          />
        </div>
        <button
          type="submit"
          class="w-full py-4 bg-[#115e59] hover:bg-[#134e4a] text-white rounded-xl font-semibold text-base transition-colors duration-200 shadow-md mt-1"
        >
          Ingresar
        </button>
      </form>

      <!-- Divider + register -->
      <div class="mt-8 text-center">
        <p class="text-gray-500 text-sm">
          ¿No tienes cuenta?
          <a href="/register" class="text-[#0f766e] font-semibold hover:underline ml-1">Regístrate aquí</a>
        </p>
        <a href="https://tdea.edu.co" target="_blank"
           class="block mt-4 text-gray-400 text-xs hover:text-[#0f766e] transition-colors">
          tdea.edu.co
        </a>
      </div>

    </div>
  </div>

</body>
</html>
