<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard - Informa TdeA</title>
  <link rel="icon" type="image/jpeg" href="/assets/Logo.jpeg" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f5f1e8] min-h-screen flex flex-col">

  <!-- Top Navbar -->
  <header class="bg-gradient-to-r from-[#115e59] to-[#0f766e] shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Brand -->
      <div class="flex items-center gap-4">
        <img src="/assets/Logo.jpeg" alt="TdeA Logo"
             class="w-12 h-12 rounded-2xl object-cover shadow" />
        <div>
          <h2 class="text-white font-bold tracking-wide text-lg leading-tight">INFORMA TDEA</h2>
          <p class="text-[#86efac] tracking-widest text-[10px]">INSTITUCIÓN UNIVERSITARIA</p>
        </div>
      </div>
      <!-- Nav links (hidden on mobile) -->
      <nav class="hidden md:flex items-center gap-8 text-white/80 font-medium text-sm">
        <a href="/dashboard" class="text-white border-b-2 border-[#86efac] pb-0.5">Inicio</a>
        <a href="/news" class="hover:text-white transition-colors">Noticias</a>
      </nav>
      <!-- Right actions -->
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
          </svg>
        </div>
        <span class="hidden md:block text-white/90 text-sm font-medium"><%= user.nombre.split(' ')[0] %></span>
        <a href="/logout"
           class="flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors text-sm font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" x2="9" y1="12" y2="12"/>
          </svg>
          Salir
        </a>
      </div>
    </div>
  </header>

  <!-- Page Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-10">

    <!-- Welcome heading -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-[#134e4a] text-3xl font-bold mb-1">Bienvenido, <%= user.nombre.split(' ')[0] %></h1>
        <p class="text-[#0f766e] text-base"><%= user.facultad.replace(/_/g, ' ') %></p>
      </div>
      <!-- Al tanto badge -->
      <div class="flex items-center gap-2 bg-[#d9f2e5] border border-[#86efac] px-4 py-2 rounded-full">
        <div class="w-6 h-6 rounded-full bg-[#86efac] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="#134e4a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17 4 12"/>
          </svg>
        </div>
        <span class="text-[#134e4a] font-bold text-sm tracking-wide">AL TANTO</span>
      </div>
    </div>

    <!-- Stats cards row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">

      <!-- Noticias -->
      <a href="/news"
         class="bg-gradient-to-br from-[#d9f2e5] to-[#86efac] rounded-3xl p-7 flex items-center justify-between shadow-md hover:shadow-xl transition-all hover:-translate-y-1 hover:scale-[1.02] cursor-pointer">
        <div class="flex items-center gap-5">
          <div class="w-14 h-14 bg-[#115e59] rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24"
                 fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
          </div>
          <div>
            <p class="text-[#134e4a] font-semibold text-lg">Noticias</p>
            <p class="text-[#0f766e] text-xs tracking-widest mt-0.5">SEMANA</p>
          </div>
        </div>
        <span class="text-[#134e4a] text-5xl font-bold"><%= totalNoticias %></span>
      </a>

      <!-- Última noticia -->
      <div class="bg-white rounded-3xl p-7 shadow-md sm:col-span-2 lg:col-span-1">
        <div class="flex justify-between items-center mb-4">
          <p class="text-[#0f766e] font-semibold text-base">Última noticia</p>
        </div>
        <% if (recentNews.length > 0) { %>
        <p class="text-[#134e4a] font-semibold text-sm leading-snug mb-4 line-clamp-2"><%= recentNews[0].titulo %></p>
        <p class="text-gray-400 text-xs mb-4 line-clamp-2"><%= recentNews[0].subtitulo %></p>
        <% } else { %>
        <p class="text-gray-400 text-sm mb-4">No hay noticias disponibles.</p>
        <% } %>
        <div class="flex gap-3">
          <a href="/news" class="flex-1 text-center bg-[#115e59] hover:bg-[#134e4a] text-white font-semibold py-3 rounded-xl transition-colors text-sm">
            Ver noticias
          </a>
        </div>
      </div>

    </div>

    <!-- Quick-access sections -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Recent news preview -->
      <div class="lg:col-span-2 bg-white rounded-3xl shadow-md overflow-hidden">
        <div class="flex items-center justify-between px-7 py-5 border-b border-gray-100">
          <h3 class="text-[#134e4a] font-bold text-lg">Noticias de tu facultad</h3>
          <a href="/news" class="text-[#0f766e] text-sm font-medium hover:underline">Ver todas →</a>
        </div>
        <div class="divide-y divide-gray-50">
          <% if (facultadNews.length === 0) { %>
          <div class="px-7 py-8 text-center text-gray-400 text-sm">No hay noticias para tu facultad aún.</div>
          <% } %>
          <% facultadNews.forEach(function(noticia) { %>
          <div class="flex gap-4 px-7 py-5 hover:bg-[#f5f1e8] transition-colors cursor-pointer"
               onclick="openNoticia(this)"
               data-titulo="<%= noticia.titulo %>"
               data-subtitulo="<%= noticia.subtitulo %>"
               data-imagen="<%= noticia.imagen %>"
               data-descripcion="<%= noticia.descripcion %>">
            <img src="<%= noticia.imagen %>" alt="<%= noticia.titulo %>"
                 onerror="this.src='https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=200&q=80'"
                 class="w-16 h-16 rounded-xl object-cover flex-shrink-0" />
            <div class="flex flex-col justify-center">
              <p class="text-[#134e4a] font-semibold text-sm leading-snug mb-1"><%= noticia.titulo %></p>
              <p class="text-gray-500 text-xs line-clamp-2"><%= noticia.descripcion %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- Upcoming events sidebar -->
      <div class="bg-white rounded-3xl shadow-md overflow-hidden">
        <div class="px-7 py-5 border-b border-gray-100">
          <h3 class="text-[#134e4a] font-bold text-lg">Próximos eventos</h3>
        </div>
        <div class="px-7 py-5 space-y-5">
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-[#d9f2e5] rounded-2xl flex flex-col items-center justify-center flex-shrink-0">
              <span class="text-[#115e59] font-bold text-base leading-none">15</span>
              <span class="text-[#0f766e] text-[10px] leading-none">JUN</span>
            </div>
            <div>
              <p class="text-[#134e4a] font-semibold text-sm leading-snug">Semana de la Ingeniería</p>
              <p class="text-gray-400 text-xs mt-0.5">Bloque F · 8:00 am</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-[#d9f2e5] rounded-2xl flex flex-col items-center justify-center flex-shrink-0">
              <span class="text-[#115e59] font-bold text-base leading-none">22</span>
              <span class="text-[#0f766e] text-[10px] leading-none">JUN</span>
            </div>
            <div>
              <p class="text-[#134e4a] font-semibold text-sm leading-snug">Feria Emprendimiento TdeA</p>
              <p class="text-gray-400 text-xs mt-0.5">Plaza principal · 10:00 am</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-[#d9f2e5] rounded-2xl flex flex-col items-center justify-center flex-shrink-0">
              <span class="text-[#115e59] font-bold text-base leading-none">30</span>
              <span class="text-[#0f766e] text-[10px] leading-none">JUN</span>
            </div>
            <div>
              <p class="text-[#134e4a] font-semibold text-sm leading-snug">Grado Segundo Semestre</p>
              <p class="text-gray-400 text-xs mt-0.5">Auditorio · 3:00 pm</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
  <!-- Modal: Ver noticia -->
  <div id="modal-noticia" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeNoticia()"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-2xl z-10 overflow-hidden max-h-[90vh] flex flex-col">
      <!-- Imagen superior -->
      <div class="relative w-full h-64 flex-shrink-0">
        <img id="modal-noticia-img" src="" alt=""
             onerror="this.src='https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&q=80'"
             class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        <button onclick="closeNoticia()"
                class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-sm flex items-center justify-center transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
        </button>
        <div class="absolute bottom-0 left-0 right-0 px-8 pb-6">
          <h2 id="modal-noticia-titulo" class="text-white text-2xl font-bold leading-snug"></h2>
        </div>
      </div>
      <!-- Descripción -->
      <div class="px-8 py-6 overflow-y-auto">
        <p id="modal-noticia-subtitulo" class="text-[#134e4a] font-bold text-sm mb-4"></p>
        <p id="modal-noticia-descripcion" class="text-gray-600 text-base leading-relaxed"></p>
      </div>
    </div>
  </div>

  <script>
    function openNoticia(el) {
      document.getElementById('modal-noticia-titulo').textContent = el.dataset.titulo || '';
      document.getElementById('modal-noticia-subtitulo').textContent = el.dataset.subtitulo || '';
      document.getElementById('modal-noticia-descripcion').textContent = el.dataset.descripcion || '';
      const img = document.getElementById('modal-noticia-img');
      img.src = el.dataset.imagen || '';
      img.alt = el.dataset.titulo || '';
      document.getElementById('modal-noticia').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeNoticia() {
      document.getElementById('modal-noticia').classList.add('hidden');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeNoticia();
    });
  </script>

</body>
</html>